---
import {
  asset,
  canonicalPath,
  categories,
  descriptions,
  email,
  github,
  labels,
  localPath,
  mail,
  products,
  productActionLabel,
  productHref,
  t,
  workflows,
  type Lang,
  type Page,
} from "./data";
import "./style.css";

interface Props {
  lang: Lang;
  page: Page;
}
const { lang, page } = Astro.props;
const copy = (zh: string, en: string) => t(lang, [zh, en]);
const url = (name: Page) => localPath(lang, name);
const nav: Page[] = ["products", "studio", "services", "contact"];
const productByDomain = Object.fromEntries(
  products.map((product) => [product.domain, product]),
);
const other = lang === "en" ? "zh-cn" : "en";
const title =
  page === "home"
    ? copy(
        "Mosuzo Studio · 把桌面上的工作做顺手",
        "Mosuzo Studio · Windows tools for everyday work",
      )
    : t(lang, labels[page]) + " · Mosuzo Studio";
const domain = "https://mosuzo.com";
const canonical = domain + canonicalPath(lang, page);
const intro = {
  products: [
    copy("找到适合你的工具。", "Find the right tool."),
    copy(
      "从截图到演示，按你正在做的事浏览。每款软件都有自己的官网与使用说明。",
      "Browse by the task at hand. Each product has its own site and documentation.",
    ),
  ],
  studio: [
    copy("我们在做什么。", "What we’re building."),
    copy(
      "Mosuzo Studio 是一个面向 Windows 桌面的软件工作室。我们从截图、录屏、图片处理和演示这些日常工作出发，设计让人愿意反复使用的工具。",
      "Mosuzo Studio makes Windows desktop software. We start with everyday tasks such as capturing, recording, editing and teaching, then build tools people can return to every day.",
    ),
  ],
  services: [
    copy("下载、授权与支持。", "Downloads, licensing and support."),
    copy(
      "已有版本可通过产品官网获取。若你正在评估商业授权、部署或售后支持，可以直接联系工作室。",
      "Get available releases from the product sites. Contact us directly about commercial licensing, deployment or support.",
    ),
  ],
  contact: [
    copy("聊聊你在做的事。", "Tell us what you’re working on."),
    copy(
      "遇到使用问题、想分享一个需求，或对联合开发感兴趣，都可以给工作室写信。",
      "Write to us about a product issue, a workflow you’d like to improve or an idea for building something together.",
    ),
  ],
};
const values = [
  [
    copy("少走一步", "Fewer steps"),
    copy(
      "把常用操作放在触手可及的地方，从抓取到分享，尽量减少切换。",
      "Keep everyday actions within reach so that capturing and sharing take fewer switches.",
    ),
  ],
  [
    copy("细节随手可查", "Details when you need them"),
    copy(
      "窗口来源、图片尺寸、按键与点击，都是能帮助人看懂过程的细节。",
      "Window origins, image dimensions, keystrokes and clicks help people understand what happened.",
    ),
  ],
  [
    copy("让工具可以组合", "Tools that work together"),
    copy(
      "一边录屏，一边显示按键。先截长图，再裁切和标注。按手头的工作选择组合。",
      "Record with a keystroke overlay, or capture a long page and trim it in the viewer. Choose the combination that fits the work.",
    ),
  ],
];
---

<!doctype html>
<html lang={lang === "en" ? "en" : "zh-CN"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={t(lang, descriptions[page])} />
    <meta name="theme-color" content="#f7f7ef" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="zh-CN"
      href={domain + canonicalPath("zh-cn", page)}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={domain + canonicalPath("en", page)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={domain + canonicalPath("zh-cn", page)}
    />
    <link rel="icon" href={asset("mosuzo.svg")} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t(lang, descriptions[page])} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip" href="#main">{copy("跳到正文", "Skip to content")}</a>
    <header class="shell top">
      <a class="brand" href={url("home")}
        ><img src={asset("mosuzo.svg")} alt="" width="34" height="34" /><span
          >Mosuzo <b>Studio</b></span
        ></a
      >
      <nav aria-label={copy("主导航", "Main navigation")}>
        {
          nav.map((n) => (
            <a
              class="nav-link"
              href={url(n)}
              aria-current={page === n ? "page" : undefined}
            >
              {t(lang, labels[n])}
            </a>
          ))
        }
      </nav>
      <a
        class="language"
        href={localPath(other, page)}
        hreflang={other}
        lang={other}
        >{other === "en" ? "EN" : "简体中文"}
        <span aria-hidden="true">↗</span></a
      >
    </header>
    <main id="main">
      {
        page === "home" ? (
          <>
            <section class="shell hero">
              <div class="hero-copy">
                <p class="eyebrow">
                  <i />
                  {copy(
                    "独立 Windows 软件工作室",
                    "INDEPENDENT WINDOWS SOFTWARE STUDIO",
                  )}
                </p>
                <h1>
                  {copy("桌面上的工作，", "Make desktop work")}
                  <br />
                  <em>{copy("可以更顺手。", "feel easier.")}</em>
                </h1>
                <p class="lead">
                  {copy(
                    "从截图、录屏到图片处理与操作演示，Mosuzo Studio 为每天要用的工作，做专注的小工具。",
                    "Mosuzo Studio builds focused Windows tools for the work you do every day, from screen capture and recording to image editing and tutorials.",
                  )}
                </p>
                <div class="actions">
                  <>
                    <a class="button primary" href={url("products")}>
                      {copy("浏览全部产品", "Explore the tools")}{" "}
                      <span aria-hidden="true">↗</span>
                    </a>
                    <a class="text-link" href={url("studio")}>
                      {copy("认识工作室", "Meet the studio")}{" "}
                      <span aria-hidden="true">→</span>
                    </a>
                  </>
                </div>
              </div>
              <div class="studio-art" aria-hidden="true">
                <div class="art-caption">
                  <>
                    <span>MOSUZO STUDIO</span>
                    <span>WINDOWS UTILITIES</span>
                  </>
                </div>
                <div class="canvas-grid" />
                <div class="tile tile-one">
                  <>
                    <span class="tile-glyph crop" />
                    <span>{copy("截图", "Capture")}</span>
                  </>
                </div>
                <div class="tile tile-two">
                  <>
                    <span class="tile-glyph record" />
                    <span>{copy("录屏", "Record")}</span>
                  </>
                </div>
                <div class="tile tile-three">
                  <>
                    <span class="tile-glyph image-glyph" />
                    <span>{copy("图片", "Image")}</span>
                  </>
                </div>
                <div class="tile tile-four">
                  <>
                    <span class="tile-glyph key-glyph">↵</span>
                    <span>{copy("演示", "Demo")}</span>
                  </>
                </div>
                <>
                  <span class="art-cross">+</span>
                  <span class="art-cross bottom">+</span>
                </>
              </div>
            </section>
            <section class="shell section" id="featured">
              <div class="section-head">
                <>
                  <div>
                    <>
                      <p class="eyebrow">
                        {copy("工作室精选", "FEATURED WORK")}
                      </p>
                      <h2>{copy("从这两款开始。", "Start with these two.")}</h2>
                    </>
                  </div>
                  <a class="text-link" href={url("products")}>
                    {copy("查看产品目录", "View the catalog")}{" "}
                    <span aria-hidden="true">→</span>
                  </a>
                </>
              </div>
              <div class="featured-grid">
                {products.slice(0, 2).map((product) => (
                  <article class={"featured card " + product.tone}>
                    <a
                      class="feature-visual"
                      href={productHref(lang, product)}
                      aria-label={
                        t(lang, productActionLabel(product)) +
                        " — " +
                        product.name
                      }
                    >
                      <img
                        src={asset(product.image!)}
                        alt={t(lang, product.imageLabel!)}
                        width="1240"
                        height="697"
                        loading="lazy"
                      />
                      <span>{t(lang, product.imageLabel!)}</span>
                    </a>
                    <div class="feature-copy">
                      <div class="product-heading">
                        <img
                          src={asset(product.domain + ".svg")}
                          alt=""
                          width="34"
                          height="34"
                        />
                        <h3>{product.name}</h3>
                        <span class="status">{t(lang, product.status)}</span>
                      </div>
                      <p class="card-title">{t(lang, product.tagline)}</p>
                      <p>{t(lang, product.description)}</p>
                      <div class="product-links">
                        <a
                          class="text-link"
                          href={productHref(lang, product)}
                        >
                          {t(lang, productActionLabel(product))}{" "}
                          <span aria-hidden="true">↗</span>
                        </a>
                        {product.download && (
                          <a class="text-link" href={product.download.href}>
                            {t(lang, product.download.label)}{" "}
                            <span aria-hidden="true">↗</span>
                          </a>
                        )}
                      </div>
                      {product.note && (
                        <p class="product-note">{t(lang, product.note)}</p>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          </>
        ) : (
          <section class="shell page-intro">
            <>
              <p class="eyebrow">
                <i />
                {t(lang, labels[page])}
              </p>
              <h1>{intro[page][0]}</h1>
              <p class="lead">{intro[page][1]}</p>
            </>
          </section>
        )
      }
      {
        (page === "home" || page === "products") && (
          <section class="shell section catalog" data-catalog>
            {page === "home" && (
              <div class="section-head">
                <div>
                  <p class="eyebrow">
                    {copy("更多作品", "MORE FROM THE STUDIO")}
                  </p>
                  <h2>
                    {copy("按手头的任务选工具。", "Pick a tool for the task.")}
                  </h2>
                </div>
              </div>
            )}
            {page === "products" && (
              <div
                class="filters"
                role="group"
                aria-label={copy("按场景筛选", "Filter by task")}
                hidden
                data-filters
              >
                <button data-filter="all" aria-pressed="true">
                  {copy("全部", "All tools")}
                </button>
                {Object.entries(categories).map(([key, label]) => (
                  <button data-filter={key} aria-pressed="false">
                    {t(lang, label)}
                  </button>
                ))}
              </div>
            )}
            <div class="product-grid">
              {products.slice(page === "home" ? 2 : 0).map((product) => (
                <article
                  class={"tool-card card " + product.tone}
                  data-category={product.category}
                >
                  <div class="tool-top">
                    <img
                      src={asset(product.domain + ".svg")}
                      alt=""
                      width="48"
                      height="48"
                    />
                    <span>{t(lang, categories[product.category])}</span>
                  </div>
                  <h3>{product.name}</h3>
                  <p class="card-title">{t(lang, product.tagline)}</p>
                  <p>{t(lang, product.description)}</p>
                  <div class="tool-end">
                    <span class="status">{t(lang, product.status)}</span>
                    <a
                      class="text-link"
                      href={productHref(lang, product)}
                      aria-label={
                        t(lang, productActionLabel(product)) +
                        " — " +
                        product.name
                      }
                    >
                      {t(lang, productActionLabel(product))}{" "}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                  {product.download && (
                    <a class="text-link" href={product.download.href}>
                      {t(lang, product.download.label)} ↗
                    </a>
                  )}
                  {product.note && (
                    <p class="product-note">{t(lang, product.note)}</p>
                  )}
                </article>
              ))}
            </div>
            {page === "products" && (
              <p
                class="sr-only"
                aria-live="polite"
                data-count
                data-label={copy("当前显示的产品数：", "Products shown: ")}
              />
            )}
          </section>
        )
      }
      {
        page === "products" && (
          <section class="shell section workflows" aria-labelledby="workflows-title">
            <div class="section-head">
              <div>
                <p class="eyebrow">
                  {copy("按任务搭配", "TOOLS FOR THE SAME WORKFLOW")}
                </p>
                <h2 id="workflows-title">
                  {copy(
                    "把两件工具接成一条工作流。",
                    "Connect two tools in one workflow.",
                  )}
                </h2>
              </div>
            </div>
            <div class="pairing-grid">
              {workflows.map((flow, index) => (
                <article class="pairing card">
                  <span class="pairing-index">0{index + 1}</span>
                  <h3>{t(lang, flow.title)}</h3>
                  <p class="pairing-desc">{t(lang, flow.description)}</p>
                  <div class="pairing-links">
                    {flow.tools.map((tool) => {
                      const product = productByDomain[tool.domain];
                      return (
                        <a class="workflow-tool" href={productHref(lang, product)}>
                          <img
                            src={asset(product.domain + ".svg")}
                            alt=""
                            width="28"
                            height="28"
                          />
                          <span class="workflow-tool-copy">
                            <b>{product.name}</b>
                            <span>{t(lang, tool.role)}</span>
                          </span>
                          <span class="workflow-tool-action">
                            {t(lang, productActionLabel(product))}{" "}
                            <span aria-hidden="true">↗</span>
                          </span>
                        </a>
                      );
                    })}
                  </div>
                  <p class="pairing-note">{t(lang, flow.note)}</p>
                </article>
              ))}
            </div>
            <p class="workflow-disclaimer">
              {copy(
                "每款工具独立安装、独立授权；这里是建议的手动衔接方式，不包含捆绑授权或自动数据传递。",
                "Each tool is installed and licensed separately. These are suggested manual hand-offs, not a bundle, shared licence or automatic data transfer.",
              )}
            </p>
          </section>
        )
      }
      {
        (page === "studio" || page === "home") && (
          <section class="studio-band">
            <div class="shell section studio-inner">
              <>
                <div>
                  <h2>
                    {copy("从具体的工作出发。", "Start with the work itself.")}
                  </h2>
                  {page === "home" && (
                    <a class="text-link" href={url("studio")}>
                      {copy("关于 Mosuzo Studio", "About Mosuzo Studio")}{" "}
                      <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
                <div class="values">
                  {values.map(([head, body]) => (
                    <article>
                      <h3>{head}</h3>
                      <p>{body}</p>
                    </article>
                  ))}
                </div>
              </>
            </div>
          </section>
        )
      }
      {
        page === "studio" && (
          <section class="shell section">
            <>
              <div class="section-head">
                <h2>{copy("欢迎一起做产品。", "Build with us.")}</h2>
              </div>
              <div class="product-grid">
                {[
                  [
                    copy("创作者与教师", "Creators and educators"),
                    copy(
                      "分享教程、录屏或演示里的真实工作流，帮助我们改进键鼠反馈与呈现方式。",
                      "Share real tutorial and recording workflows to help us improve how input and results appear on screen.",
                    ),
                  ],
                  [
                    copy("设计师与开发者", "Designers and developers"),
                    copy(
                      "如果你关注桌面体验、可访问性或跨应用协作，欢迎发来作品与想法。",
                      "If you care about desktop UX, accessibility or cross-app workflows, send us a sample of your work and an idea.",
                    ),
                  ],
                  [
                    copy("团队与渠道伙伴", "Teams and distribution partners"),
                    copy(
                      "告诉我们你的使用场景、目标用户或分发需求，一起讨论合作方式。",
                      "Tell us about your use case, audience or distribution needs so we can discuss a fit.",
                    ),
                  ],
                ].map(([heading, body]) => (
                  <article class="card service-card">
                    <h3>{heading}</h3>
                    <p>{body}</p>
                  </article>
                ))}
              </div>
            </>
          </section>
        )
      }
      {
        page === "services" && (
          <section class="shell section">
            <div class="product-grid">
              {[
                [
                  copy("获取软件", "Get the software"),
                  copy(
                    "按产品查看已公布的版本、系统要求与下载入口。",
                    "Find published versions, system requirements and downloads by product.",
                  ),
                  copy("浏览产品", "Browse products"),
                  url("products"),
                  copy("已开放", "Available"),
                ],
                [
                  copy("购买与激活码", "Purchases and activation codes"),
                  copy(
                    "计划提供在线购买、激活码交付与使用说明。价格、适用产品和授权范围将在正式开放时公布。",
                    "Online purchasing, activation code delivery and activation instructions are planned. Pricing, eligible products and license terms will be published at launch.",
                  ),
                  copy("咨询授权", "Ask about licensing"),
                  mail("Mosuzo Studio — Licensing"),
                  copy("规划中", "Planned"),
                ],
                [
                  copy("客服与售后", "Customer support"),
                  copy(
                    "现可通过邮箱反馈使用或授权问题。订单查询、激活码补发等自助服务将在交易功能开放后规划。",
                    "Email us now about product or licensing issues. Self-service order lookup and code reissue are planned for a later phase.",
                  ),
                  copy("联系支持", "Contact support"),
                  mail("Mosuzo Studio — Product support"),
                  copy("邮箱可用", "Email available"),
                ],
              ].map(([heading, body, link, href, state]) => (
                <article class="card service-card">
                  <span class="status">{state}</span>
                  <h3>{heading}</h3>
                  <p>{body}</p>
                  <a class="text-link" href={href}>
                    {link} <span aria-hidden="true">↗</span>
                  </a>
                </article>
              ))}
            </div>
            <div class="service-faq">
              <h2>{copy("常见问题", "Common questions")}</h2>
              <details>
                <>
                  <summary>
                    {copy("可以在这里付款吗？", "Can I pay on this site?")}
                  </summary>
                  <p>
                    {copy(
                      "在线结账尚未开放。产品下载以各官网公开发布的版本为准。",
                      "Online checkout is still planned. For downloads, use the versions published on each product site.",
                    )}
                  </p>
                </>
              </details>
              <details>
                <>
                  <summary>
                    {copy(
                      "团队采购需要提供什么？",
                      "What should I include in a team inquiry?",
                    )}
                  </summary>
                  <p>
                    {copy(
                      "请写明产品名称、预计席位数、使用场景以及希望了解的部署或支持方式。",
                      "Include the product name, expected seat count, use case and any deployment or support requirements.",
                    )}
                  </p>
                </>
              </details>
            </div>
          </section>
        )
      }
      {
        page === "contact" && (
          <section class="shell section">
            <div class="contact-panel">
              <>
                <div>
                  <>
                    <p class="eyebrow">{copy("工作室邮箱", "STUDIO EMAIL")}</p>
                    <h2>
                      <a href={"mailto:" + email}>{email}</a>
                    </h2>
                    <p>
                      {copy(
                        "来信中可以附上产品名、版本和场景，方便我们定位问题。",
                        "Include the product, version and context when reporting a problem.",
                      )}
                    </p>
                  </>
                </div>
                <div class="contact-actions">
                  <>
                    <a
                      class="button primary"
                      href={mail("Mosuzo Studio — Partnership")}
                    >
                      {copy("联系合作", "Discuss a partnership")} ↗
                    </a>
                    <a
                      class="text-link"
                      href={mail("Mosuzo Studio — Product feedback")}
                    >
                      {copy("反馈产品问题", "Send product feedback")} ↗
                    </a>
                  </>
                </div>
              </>
            </div>
            <div class="product-grid channels">
              <article class="card service-card">
                <>
                  <h3>GitHub</h3>
                  <p>
                    {copy(
                      "查看公开项目与版本发布。在对应产品仓库提交建议。",
                      "Browse public projects and releases, or share feedback in a product repository.",
                    )}
                  </p>
                  <a class="text-link" href={github}>
                    {copy("查看工作室组织", "Visit our organization")} ↗
                  </a>
                </>
              </article>
              <article class="card service-card">
                <>
                  <h3>QQ / {copy("微信", "WeChat")}</h3>
                  <p>
                    {copy(
                      "群聊或客服账号将在确认后公布。当前请通过邮箱联系。",
                      "Group and support accounts will be listed when confirmed. Email is available now.",
                    )}
                  </p>
                  <span class="status">{copy("待公布", "Pending")}</span>
                </>
              </article>
              <article class="card service-card">
                <>
                  <h3>{copy("小红书", "Xiaohongshu")}</h3>
                  <p>
                    {copy(
                      "计划分享软件技巧、更新与工作室日常。",
                      "We plan to share tips, product updates and studio notes.",
                    )}
                  </p>
                  <span class="status">{copy("待公布", "Pending")}</span>
                </>
              </article>
            </div>
          </section>
        )
      }
      {
        (page === "home" || page === "studio") && (
          <section class="shell section">
            <div class="contact-panel">
              <>
                <div>
                  <>
                    <p class="eyebrow">
                      {copy("反馈与合作", "FEEDBACK & PARTNERSHIPS")}
                    </p>
                    <h2>
                      {copy("有想法？一起聊聊。", "Have something in mind?")}
                    </h2>
                    <p>
                      {copy(
                        "欢迎来信聊聊使用问题、授权需求，或者你想一起做的产品。",
                        "Tell us about a support question, a licensing need or a product you’d like to build together.",
                      )}
                    </p>
                  </>
                </div>
                <div class="contact-actions">
                  <>
                    <a class="button primary" href={url("contact")}>
