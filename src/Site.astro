    <script>
      const catalog = document.querySelector<HTMLElement>("[data-catalog]");
      const filterGroup = catalog?.querySelector<HTMLElement>("[data-filters]");
      if (catalog && filterGroup) {
        filterGroup.hidden = false;
        const buttons = filterGroup.querySelectorAll<HTMLButtonElement>(
          "button[data-filter]",
        );
        const cards = catalog.querySelectorAll<HTMLElement>("[data-category]");
        const announcement = catalog.querySelector<HTMLElement>("[data-count]");
        for (const button of buttons) {
          button.addEventListener("click", () => {
            for (const candidate of buttons)
              candidate.setAttribute(
                "aria-pressed",
                String(candidate === button),
              );
            let visible = 0;
            for (const card of cards) {
              card.hidden =
                button.dataset.filter !== "all" &&
                card.dataset.category !== button.dataset.filter;
              if (!card.hidden) visible++;
            }
            if (announcement)
              announcement.textContent =
                (announcement.dataset.label ?? "") + visible;
          });
        }
      }
    </script>
  </body>
</html>
